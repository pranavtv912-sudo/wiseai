"""
Environment Configuration File
Copy this file to .env and fill in your actual values
"""

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database Configuration
# For MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/resumewise

# For SQLite (development):
# DATABASE_URL=sqlite:///resumewise.db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# External API Keys
GEMINI_API_KEY=your-google-gemini-api-key
YOUTUBE_API_KEY=your-youtube-api-key
ADZUNA_API_ID=your-adzuna-api-id
ADZUNA_API_KEY=your-adzuna-api-key
EMAILJS_API_KEY=your-emailjs-api-key
EMAILJS_PRIVATE_KEY=

# CORS Configuration (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# File Upload Configuration
MAX_FILE_SIZE=16777216
UPLOAD_FOLDER=uploads

# Spacy Model
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=INFO
