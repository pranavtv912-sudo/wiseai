"""
Test Environment Configuration - SQLite for easier testing without MySQL
"""

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=test-secret-key-for-development

# Database Configuration (SQLite for testing - no MySQL required)
DATABASE_URL=sqlite:///test_resumewise.db

# JWT Configuration
JWT_SECRET_KEY=test-jwt-secret-key

# External API Keys (optional for testing)
GEMINI_API_KEY=test-gemini-key
YOUTUBE_API_KEY=test-youtube-key
ADZUNA_API_ID=test-adzuna-id
ADZUNA_API_KEY=test-adzuna-key
EMAILJS_API_KEY=test-emailjs-key

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000
